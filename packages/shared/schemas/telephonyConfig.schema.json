{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqmo.dev/schemas/telephonyConfig.schema.json",
  "title": "Reqmo Telephony Config",
  "type": "object",
  "required": ["id", "providerName", "adapterType", "enabled"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "providerName": { "type": "string", "minLength": 1 },
    "adapterType": { "enum": ["WEBHOOK", "SIP", "CTI", "SERIAL_COM"] },
    "enabled": { "type": "boolean" },
    "endpoint": { "type": "string" },
    "parsingRules": { "type": "object" },
    "failoverConfig": { "type": "object" }
  }
}
